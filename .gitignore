# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# One-off backfill ledger — contains subscriber email addresses
scripts/.backfill-sent.json

# Belt and braces on a public repo: .env.local holds every credential the
# site has, and one mis-typed `git add` would publish them. `.vercel` is
# already covered above; this catches every .env variant.
.env*

# Full test report, written by `npm run test:trace` when chasing an
# intermittent failure. Never commit it.
.vitest-report.json

# Local dev server output
dev.log
.reel-frames
.reel-preview
