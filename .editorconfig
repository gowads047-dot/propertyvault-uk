root = true

[*]
# utf-8, NOT utf-8-bom — a stray BOM at the top of a .ts/.tsx file makes the
# whole file read as modified and pollutes every diff.
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
