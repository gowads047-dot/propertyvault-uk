generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USERS & AUTH
// ==========================================

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  firstName     String?
  lastName      String?
  avatarUrl     String?
  role          UserRole  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       UserProfile?
  subscriptions Subscription[]
  savedArticles SavedArticle[]
  forumPosts    ForumPost[]
  forumComments ForumComment[]
  calculatorSaves CalculatorSave[]
  courseEnrollments CourseEnrollment[]
  newsletterSub NewsletterSubscriber?
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investorType    String?
  experience      String?
  portfolioSize   Int      @default(0)
  location        String?
  bio             String?
  linkedinUrl     String?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum UserRole {
  FREE
  PRO
  ACADEMY
  ADMIN
  AUTHOR
}

// ==========================================
// SUBSCRIPTIONS & PAYMENTS
// ==========================================

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String?
  stripeSubId      String?            @unique
  plan             UserRole
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean           @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  PAUSED
}

// ==========================================
// CONTENT MANAGEMENT
// ==========================================

model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String?
  content       String
  featuredImage String?
  category      String
  tags          String[]
  authorName    String
  authorBio     String?
  status        ContentStatus @default(DRAFT)
  isPremium     Boolean       @default(false)
  readTime      Int?
  seoTitle      String?
  seoDescription String?
  seoKeywords   String[]
  schemaType    String        @default("Article")
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  savedBy       SavedArticle[]
  faqs          ArticleFAQ[]

  @@index([category])
  @@index([status, publishedAt])
  @@index([slug])
}

model ArticleFAQ {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int     @default(0)
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// ==========================================
// COURSES & LEARNING
// ==========================================

model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  thumbnail   String?
  category    String
  difficulty  String
  duration    String?
  isPremium   Boolean       @default(true)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  videoUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  lessons   CourseLesson[]
}

model CourseLesson {
  id        String       @id @default(cuid())
  moduleId  String
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  videoUrl  String?
  duration  Int?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
}

model CourseEnrollment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress       Int      @default(0)
  completedAt    DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime @default(now())

  @@unique([userId, courseId])
}

// ==========================================
// COMMUNITY & FORUM
// ==========================================

model ForumCategory {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  sortOrder   Int         @default(0)
  posts       ForumPost[]
}

model ForumPost {
  id         String         @id @default(cuid())
  categoryId String
  category   ForumCategory  @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  content    String
  isPinned   Boolean        @default(false)
  isLocked   Boolean        @default(false)
  viewCount  Int            @default(0)
  likeCount  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  comments   ForumComment[]

  @@index([categoryId, createdAt])
}

model ForumComment {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  likeCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ==========================================
// CALCULATORS
// ==========================================

model CalculatorSave {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculatorType String
  name           String
  inputs         Json
  results        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, calculatorType])
}

// ==========================================
// NEWSLETTER & LEADS
// ==========================================

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String   @unique
  firstName   String?
  source      String?
  isActive    Boolean  @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  firstName String?
  lastName  String?
  phone     String?
  source    String
  type      String
  status    String   @default("new")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
}

// ==========================================
// EVENTS
// ==========================================

model Event {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  eventType   String
  location    String?
  isOnline    Boolean       @default(false)
  startDate   DateTime
  endDate     DateTime?
  maxAttendees Int?
  price       Float         @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  registrations EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email     String
  firstName String
  lastName  String?
  createdAt DateTime @default(now())

  @@unique([eventId, email])
}

// ==========================================
// PROPERTY LISTINGS (OpenRent-style)
// ==========================================

model PropertyListing {
  id              String        @id @default(cuid())
  landlordId      String
  listingType     String        // for-rent, for-sale, deal-source, social-housing
  propertyType    String        // house, flat, hmo, commercial, land, mixed-use
  title           String
  description     String
  addressLine1    String
  addressLine2    String?
  city            String
  county          String?
  postcode        String
  latitude        Float?
  longitude       Float?
  bedrooms        Int           @default(0)
  bathrooms       Int           @default(0)
  furnished       String        @default("unfurnished")
  price           Float
  priceFrequency  String        // pcm, pw, pn, fixed
  deposit         Float?
  availableFrom   DateTime?
  minimumTenancy  String?
  features        String[]
  tenantPrefs     String[]
  dssAccepted     Boolean       @default(false)
  petsAllowed     Boolean       @default(false)
  images          String[]
  floorPlanUrl    String?
  videoTourUrl    String?
  epcRating       String?
  epcUrl          String?
  gasSafeUrl      String?
  eicrUrl         String?
  hmoLicenceUrl   String?
  isVerified      Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  plan            String        @default("free") // free, featured, premium
  status          String        @default("draft") // draft, active, let-agreed, withdrawn
  viewCount       Int           @default(0)
  enquiryCount    Int           @default(0)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enquiries       PropertyEnquiry[]

  @@index([city, status])
  @@index([postcode])
  @@index([listingType, status])
  @@index([status, publishedAt])
}

model PropertyEnquiry {
  id          String          @id @default(cuid())
  listingId   String
  listing     PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  message     String
  moveInDate  DateTime?
  status      String          @default("new") // new, viewed, replied, shortlisted, rejected
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([listingId, status])
}

// ==========================================
// DEAL SOURCING MARKETPLACE
// ==========================================

model DealSourcer {
  id                    String   @id @default(cuid())
  userId                String   @unique
  companyName           String
  location              String
  bio                   String?
  specialisms           String[]
  tpoMembership         String?
  piInsurance           Boolean  @default(false)
  icoRegistration       String?
  amlCompliant          Boolean  @default(false)
  isVerified            Boolean  @default(false)
  totalDeals            Int      @default(0)
  rating                Float    @default(0)
  reviewCount           Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  deals                 SourcedDeal[]
}

model SourcedDeal {
  id              String       @id @default(cuid())
  sourcerId       String
  sourcer         DealSourcer  @relation(fields: [sourcerId], references: [id], onDelete: Cascade)
  title           String
  location        String
  postcode        String
  propertyType    String
  strategy        String       // brrr, btl, hmo, sa, development, social-housing, portfolio
  purchasePrice   Float
  omv             Float?
  refurbCost      Float?
  arv             Float?
  monthlyRent     Float?
  grossYield      Float?
  sourcingFee     Float
  description     String
  comparables     String?
  images          String[]
  status          String       @default("pending") // pending, approved, sold, withdrawn
  isVerified      Boolean      @default(false)
  viewCount       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([strategy, status])
  @@index([location])
}

// ==========================================
// TENANCY MANAGEMENT
// ==========================================

model Tenancy {
  id                String    @id @default(cuid())
  landlordId        String
  propertyAddress   String
  tenantName        String
  tenantEmail       String
  tenantPhone       String?
  rentAmount        Float
  rentFrequency     String    @default("monthly")
  depositAmount     Float?
  depositScheme     String?   // dps, mydeposits, tds
  depositRef        String?
  tenancyStart      DateTime
  tenancyEnd        DateTime?
  isRolling         Boolean   @default(false)
  status            String    @default("active") // active, notice-served, ended
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  rentPayments      RentPayment[]
  complianceItems   ComplianceItem[]
  maintenanceJobs   MaintenanceJob[]

  @@index([landlordId])
}

model RentPayment {
  id          String   @id @default(cuid())
  tenancyId   String
  tenancy     Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String   @default("pending") // pending, paid, late, missed
  method      String?  // direct-debit, bank-transfer, cash
  reference   String?
  createdAt   DateTime @default(now())

  @@index([tenancyId, dueDate])
}

model ComplianceItem {
  id          String    @id @default(cuid())
  tenancyId   String?
  tenancy     Tenancy?  @relation(fields: [tenancyId], references: [id], onDelete: SetNull)
  landlordId  String
  type        String    // gas-safety, eicr, epc, hmo-licence, insurance, smoke-alarms
  description String
  issueDate   DateTime?
  expiryDate  DateTime
  documentUrl String?
  status      String    @default("valid") // valid, expiring-soon, expired
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([landlordId, type])
  @@index([expiryDate])
}

model MaintenanceJob {
  id          String   @id @default(cuid())
  tenancyId   String
  tenancy     Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  title       String
  description String
  priority    String   @default("medium") // low, medium, high, emergency
  status      String   @default("reported") // reported, assigned, in-progress, completed
  reportedBy  String   // tenant or landlord
  assignedTo  String?
  cost        Float?
  images      String[]
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenancyId, status])
}

// ==========================================
// TENANT REFERENCING
// ==========================================

model TenantReference {
  id              String   @id @default(cuid())
  landlordId      String
  tenantName      String
  tenantEmail     String
  creditCheck     String?  // pass, fail, refer
  employmentCheck String?  // verified, unverified, self-employed
  landlordRef     String?  // satisfactory, unsatisfactory, no-previous
  rightToRent     String?  // confirmed, pending, failed
  affordability   String?  // pass, marginal, fail
  overallResult   String?  // pass, fail, refer
  reportUrl       String?
  status          String   @default("pending") // pending, in-progress, completed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([landlordId])
}

// ==========================================
// TRADES MARKETPLACE
// ==========================================

model Tradesperson {
  id                String   @id @default(cuid())
  userId            String?  @unique
  businessName      String
  tradePrimary      String
  tradesAdditional  String[]
  location          String
  postcode          String
  coverageRadius    Int      @default(25)
  bio               String?
  hourlyRate        String?
  accreditations    String[]
  insuranceVerified Boolean  @default(false)
  gassSafeNumber    String?
  niceicNumber      String?
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  responseTime      String?
  isVerified        Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  quotes            TradeQuote[]

  @@index([tradePrimary, location])
}

model TradeJob {
  id            String   @id @default(cuid())
  postedById    String
  title         String
  description   String
  tradeRequired String
  location      String
  postcode      String
  budget        String?
  urgency       String   @default("this-week")
  propertyType  String?
  images        String[]
  status        String   @default("open") // open, assigned, completed, cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotes        TradeQuote[]

  @@index([tradeRequired, status])
  @@index([postcode])
}

model TradeQuote {
  id              String       @id @default(cuid())
  jobId           String
  job             TradeJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tradespersonId  String
  tradesperson    Tradesperson @relation(fields: [tradespersonId], references: [id], onDelete: Cascade)
  amount          Float?
  message         String
  estimatedDays   Int?
  status          String       @default("pending") // pending, accepted, declined
  createdAt       DateTime     @default(now())

  @@unique([jobId, tradespersonId])
}

model TradeReview {
  id              String   @id @default(cuid())
  tradespersonId  String
  reviewerId      String
  jobTitle        String
  rating          Int
  comment         String
  wouldRecommend  Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([tradespersonId])
}

// ==========================================
// AFFILIATE & MONETISATION
// ==========================================

model AffiliatePartner {
  id           String   @id @default(cuid())
  name         String
  category     String
  description  String?
  trackingUrl  String
  commission   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  clicks       AffiliateClick[]
}

model AffiliateClick {
  id        String           @id @default(cuid())
  partnerId String
  partner   AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  source    String?
  ipHash    String?
  createdAt DateTime         @default(now())

  @@index([partnerId, createdAt])
}
